rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      function isAdmin() {
        return request.auth != null
          && request.auth.token.email == '252quanghuy@gmail.com';
      }

      function hasValidProductFields() {
        return request.resource.data.keys().hasAll(
            ['name', 'price', 'soluong', 'image']
          )
          && request.resource.data.keys().hasOnly(
            ['name', 'price', 'soluong', 'image']
          )
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.soluong is int
          && request.resource.data.soluong >= 0
          && request.resource.data.image is string
          && request.resource.data.image.size() > 0;
      }

      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && hasValidProductFields();
    }
  }
}
